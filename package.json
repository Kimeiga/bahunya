{
  "name": "bahunya",
  "version": "2.0.0",
  "description": "A classless CSS framework with a navbar and dark styling.",
  "style": "dist/bahunya.css",
  "main": "dist/bahunya.css",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test",
    "check": "node scripts/check-build.mjs && node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimeiga/bahunya.git"
  },
