  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "css",
    "css-framework",
    "simple",
    "minimal",
    "classless"
  ],
  "author": "Hakan Alpay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kimeiga/bahunya/issues"
  },
  "homepage": "https://kimeiga.github.io/bahunya/",
  "engines": {
    "node": ">=20"
  }
}
